DIFY_BASE_URL=http://localhost
DIFY_API_KEY=
DIFY_USER=sh
DIFY_TIMEOUT=120
DIFY_APP_MODE=advanced-chat
LOCAL_FALLBACK=true
WEATHER_ENABLED=true
WEATHER_TRUST_ENV=false
ROUTE_TRUST_ENV=false
DIFY_MODEL=dify
# Optional estimated price per 1k tokens; never treated as a provider bill.
DIFY_COST_PER_1K=0
# Docker Desktop only: DIFY_DOCKER_BASE_URL=http://host.docker.internal
# With docker-compose.dify.yml: defaults to http://nginx on docker_default
# DIFY_DOCKER_NETWORK=docker_default

# Generation request limit per IP per hour (single process).
GENERATION_LIMIT_PER_HOUR=20
# Optional separate SQLite file; default is data/travel.db.
# TRAVEL_DB_PATH=data/travel.db
